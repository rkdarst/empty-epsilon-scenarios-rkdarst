# Apptainer recipe: a self-contained Debian image that INSTALLS Empty Epsilon.
# The official deb is copied in and installed with apt, so the image carries
# its own SDL2/X11/GL stack and needs nothing from the host except a display.
#
# Build from the repo ROOT (%files paths are relative to the build CWD),
# on any machine with apptainer (requires root, or rootless --fakeroot):
#   ./tools/get_ee.sh                                   # caches the deb in vendor/
#   apptainer build vendor/ee.sif tools/ee.def          # portable image
#   apptainer build --fakeroot --sandbox vendor/ee-rootfs tools/ee.def
#       # rootless-friendly form; use it where the kernel lacks the squashfs
#       # module (SIF files cannot be mounted then). tools/ee_run.sh picks
#       # automatically between vendor/ee.sif and vendor/ee-rootfs.
#
# Play graphically with the host HOME hidden from the game — just run:
#   tools/ee_run.sh                    # window on $DISPLAY, scenarios bound in
#   tools/ee_run.sh headless=scenario_40_lostcluster.lua startpaused=1
#
# Home isolation is a RUNTIME policy: always pass --no-home (and ideally
# --contain, which also drops the auto-bind of your CWD and the /tmp + /home
# mounts). That is exactly what tools/ee_run.sh enforces; the scratch home
# lives at /opt/eehome (outside /tmp and /home, so --contain cannot hide it).
#
# The base rootfs is pulled from Docker Hub (needs outbound HTTPS to
# registry-1.docker.io; anonymous pulls are rate-limited, but the layers are
# cached under ~/.apptainer/cache after the first build). If a build host
# cannot reach Docker Hub, swap the two Bootstrap lines for:
#   Bootstrap: debootstrap
#   MirrorURL: http://deb.debian.org/debian/
#   OSVersion: stable
Bootstrap: docker
From: debian:stable

%labels
    Maintainer rkdarst
    GameVersion EE-2024.12.08
    Method apt-install of the official deb into Debian stable

%help
    Debian stable with Empty Epsilon installed under /usr/local
    (binary /usr/local/bin/EmptyEpsilon, data /usr/local/share/emptyepsilon).
    Scratch home is /opt/eehome; the game reads scenarios from
    /opt/eehome/.emptyepsilon/scripts (bind your scenarios/ dir there,
    read-only — tools/ee_run.sh does this plus --no-home --contain).

%files
    # adjust the tag if you fetched a different release with tools/get_ee.sh
    # NB: stage under /opt, NOT /tmp — the build masks /tmp while %post runs,
    # so a /tmp copy would be invisible to the installer.
    vendor/Linux_EmptyEpsilon_EE-2024.12.08.deb /opt/emptyepsilon.deb

%post
    export DEBIAN_FRONTEND=noninteractive
    test -f /opt/emptyepsilon.deb || {
        echo "ee.def: /opt/emptyepsilon.deb missing - run ./tools/get_ee.sh and build from the repo root" >&2
        exit 1
    }
    apt-get update
    # the real install; dpkg first, then -f pulls libSDL2 + its X11/ALSA/Pulse
    # chain from Debian (this combo avoids apt's deb-path quirks entirely)
    dpkg -i /opt/emptyepsilon.deb || apt-get -f install -y
    # OpenGL: GPU-backed via a /dev/dri bind when available, llvmpipe otherwise
    apt-get install -y --no-install-recommends \
        libgl1 libglx0 libglx-mesa0 libgl1-mesa-dri fontconfig fonts-dejavu-core
    # Debian trixie moved the Gallium drivers into mesa-libgallium; harmless
    # "not found" failure on older releases:
    apt-get install -y --no-install-recommends mesa-libgallium || true
    rm -f /opt/emptyepsilon.deb
    rm -rf /var/lib/apt/lists/* /var/cache/apt
    # scratch home used when the container runs with --no-home/--contain
    mkdir -p /opt/eehome/.emptyepsilon/scripts

%environment
    export HOME=/opt/eehome
    export EE_CONF_DIR=/opt/eehome/.emptyepsilon

%runscript
    # The binary resolves resources/ scripts/ packs/ relative to its CWD
    # (verified for EE-2024.12.08), so start from the data dir. Custom
    # scenarios still come from $EE_CONF_DIR/scripts (the fallback path).
    if [ $# -gt 0 ] && expr "$1" : 'headless=' >/dev/null 2>&1; then
        export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-dummy}"
    fi
    cd /usr/local/share/emptyepsilon
    exec /usr/local/bin/EmptyEpsilon "$@"
